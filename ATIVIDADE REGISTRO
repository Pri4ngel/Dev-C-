#include <stdio.h>
#include <string.h>
#include <windows.h>
#include <locale.h>

#define MAX 5

struct Personagem {
    char nome[20];
    char transformacao[30];
    char poderEspecial[50];
    int nivelPoder;
};

// Função para cadastrar um personagem
void cadastrar(struct Personagem *p) {
    printf("Nome: ");
    scanf(" %[^\n]", p->nome);

    printf("Transformação: ");
    scanf(" %[^\n]", p->transformacao);

    printf("Poder especial: ");
    scanf(" %[^\n]", p->poderEspecial);

    printf("Nível de poder: ");
    scanf("%d", &p->nivelPoder);
}

// Função para listar personagens
void listar(struct Personagem p[], int total) {
    int i;

    for (i = 0; i < total; i++) {
        printf("\nPersonagem %d", i + 1);
        printf("\nNome: %s", p[i].nome);
        printf("\nTransformação: %s", p[i].transformacao);
        printf("\nPoder especial: %s", p[i].poderEspecial);
        printf("\nNível de poder: %d\n", p[i].nivelPoder);
    }
}

int main() {
	setlocale(LC_ALL, "Portuguese");
	
    struct Personagem lr[3];
    struct Personagem p1, p2;
    struct Personagem personagens[MAX];

    int i, opcao, total = 0;

    // Cadastro das 3 personagens da equipe Z
    printf("Cadastro do LollyRock\n");

    for (i = 0; i < 3; i++) {
        printf("\nPersonagem %d\n", i + 1);
        cadastrar(&lr[i]);
    }

    // Mostrar personagem com maior nível de poder
    int maior = 0;
    for (i = 1; i < 3; i++) {
        if (lr[i].nivelPoder > lr[maior].nivelPoder) {
            maior = i;
        }
    }

    printf("\nPersonagem com maior nível de poder:");
    printf("\nNome: %s", lr[maior].nome);
    printf("\nTransformação: %s", lr[maior].transformacao);
    printf("\nPoder especial: %s", lr[maior].poderEspecial);
    printf("\nNível de poder: %d\n", lr[maior].nivelPoder);

    // Cópia de personagem (p2 = p1)
    p1 = lr[0]; // primeira personagem
    p2 = p1;

    printf("\nPersonagem copiado:");
    printf("\nNome: %s", p2.nome);
    printf("\nPoder especial: %s\n", p2.poderEspecial);

    // Menu simples
    do {
        printf("\nMENU");
        printf("\n1 - Cadastrar personagem");
        printf("\n2 - Listar personagens");
        printf("\n0 - Sair");
        printf("\nOpção: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total < MAX) {
                cadastrar(&personagens[total]);
                total++;
            } else {
                printf("\nVetor cheio!\n");
            }
        } 
        else if (opcao == 2) {
            listar(personagens, total);
        } 
        else if (opcao == 0) {
            printf("\nEncerrando programa...\n");
        } 
        else {
            printf("\nOpção inválida!\n");
        }

    } while (opcao != 0);

    return 0;
}
